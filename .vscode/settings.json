{
  "dart.flutterSdkPath": null,
  "dart.defaultDevice": "chrome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "dart.lineLength": 100,
  "files.associations": {
    "*.dart": "dart"
  },
  "editor.rulers": [100],
  "dart.previewFlutterUiGuides": true,
  "dart.showTodos": true
}
